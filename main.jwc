// Task Tracker API (Trello/Linear-lite) — JWC dogfooding build.
// Phase 1: auth + User + Workspace + membership.

route GET "/ping" {
    return json({ service: "task-tracker", ok: true });
}

function main() {
    setConnectionString();

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
