# Postgres (DATABASE_URL or PG_* fields):
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=secret
PG_DATABASE=task_tracker

# REQUIRED — used by jwt.sign / jwt.verify.
JWT_SECRET=change-me-in-production

# REQUIRED — signs the keyset pagination cursors. A cursor is a
# client-supplied predicate; unsigned, it is a second filter nobody checked
# (config.md §3).
CURSOR_SECRET=change-me-in-production

# PORT=8080
