dome AuthService {
    // 0.4.9: an entity-typed return now accepts a select-loaded Record, so the
    // annotation that 0.4.8 forced us to drop is back.
    function findByEmail(email: string): User? {
        return select User from AppDb.User where User.email == @email first;
    }

    function register(data: RegisterRequest): User {
        let u = new User();
        u.email = data.email;
        u.passwordHash = hash_password(data.password);
        u.name = data.name;
        u.createdAt = now();
        insert u into AppDb.User;
        return u;
    }
}
