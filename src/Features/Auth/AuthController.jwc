route POST "/auth/register" {
    validate body {
        email:    required, pattern(r"^[^@]+@[^@]+\.[^@]+$");
        password: required, minLength(8), maxLength(200);
        name:     required, minLength(1), maxLength(120);
    }
    let req = body();
    let existing = AuthService.findByEmail(req.email);
    if (existing != null) {
        return badRequest({ error: "email already registered" });
    }
    let u = AuthService.register(req);
    return created(json({ id: u.id, email: u.email, name: u.name }));
}

route POST "/auth/login" {
    validate body {
        email:    required;
        password: required;
    }
    let req = body();
    let u = AuthService.findByEmail(req.email);
    if (u == null) {
        return unauthorized();
    }
    let ok = verify_password(req.password, u.passwordHash);
    if (!ok) {
        return unauthorized();
    }
    let token = jwt_sign({ sub: u.id }, env("JWT_SECRET"));
    return json({ token: token });
}
