dome ActivityService {
    function record(projectId: int, actorId: int, kind: string, payload) {
        let a = new Activity();
        a.projectId = projectId;
        a.actorId = actorId;
        a.type = kind;
        a.payload = payload;
        a.createdAt = now();
        insert a into AppDb.Activity;
    }

    // Query Layer: `with actor` eager-loads the User (projected to id+name) in
    // one json subquery — no per-row N+1.
    function listByProject(projectId: int) {
        return select Activity with actor from AppDb.Activity
            where Activity.projectId == @projectId
            orderby Activity.createdAt desc
            limit 50;
    }
}
