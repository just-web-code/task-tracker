// API docs - Swagger UI (/docs) + hand-written OpenAPI spec (/openapi.json).
//
// HONEST NOTE: JWC does not generate OpenAPI from the route/validate blocks yet,
// and its object literals cannot express this document (string keys like "/foo"
// and "200", plus array literals, are not allowed) - so openapi_spec() below is
// a hand-written JSON string. It currently covers every route 1:1, but nothing
// keeps it in sync with the code: update openapi_spec() whenever a route changes.
// Same approach as jwc-shortener (for now, for testing).

route GET "/docs" {
    return html(swagger_ui_html());
}

route GET "/openapi.json" {
    return openapi_spec();
}

function swagger_ui_html(): string {
    return r"<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<title>Task Tracker API - Swagger UI</title>
<link rel='stylesheet' href='https://unpkg.com/swagger-ui-dist@5/swagger-ui.css'>
<style>body { margin: 0; }</style>
</head>
<body>
<div id='swagger-ui'></div>
<script src='https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js'></script>
<script>
window.onload = function () {
  window.ui = SwaggerUIBundle({
    url: '/openapi.json',
    dom_id: '#swagger-ui',
    deepLinking: true,
    presets: [SwaggerUIBundle.presets.apis],
    layout: 'BaseLayout'
  });
};
</script>
</body>
</html>";
}
function openapi_spec(): string {
    return "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Task Tracker API\",\"version\":\"0.1.0\",\"description\":\"Trello/Linear-lite task tracker - JWC dogfooding build. Auth is JWT Bearer (POST /auth/login -\\u003e token, send as `Authorization: Bearer \\u003ctoken\\u003e`). NOTE: this OpenAPI document is hand-maintained - JWC does not generate it from the route/validate definitions yet, so it is best-effort and can drift from the code.\"},\"servers\":[{\"url\":\"http://localhost:8080\"}],\"tags\":[{\"name\":\"Health\"},{\"name\":\"Auth\"},{\"name\":\"Workspaces\"},{\"name\":\"Projects\"},{\"name\":\"Boards\"},{\"name\":\"Columns\"},{\"name\":\"Tasks\"},{\"name\":\"Labels\"},{\"name\":\"Comments\"},{\"name\":\"Stats\"},{\"name\":\"Activity\"},{\"name\":\"Docs\"}],\"components\":{\"securitySchemes\":{\"bearerAuth\":{\"type\":\"http\",\"scheme\":\"bearer\",\"bearerFormat\":\"JWT\"}}},\"paths\":{\"/ping\":{\"get\":{\"tags\":[\"Health\"],\"summary\":\"Liveness ping\",\"responses\":{\"200\":{\"description\":\"Service is up\"}}}},\"/auth/register\":{\"post\":{\"tags\":[\"Auth\"],\"summary\":\"Register a new user\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"email\",\"password\",\"name\"],\"properties\":{\"email\":{\"type\":\"string\",\"format\":\"email\"},\"password\":{\"type\":\"string\",\"minLength\":8,\"maxLength\":200},\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":120}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed / email already registered\"}}}},\"/auth/login\":{\"post\":{\"tags\":[\"Auth\"],\"summary\":\"Log in, returns a JWT\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"email\",\"password\"],\"properties\":{\"email\":{\"type\":\"string\",\"format\":\"email\"},\"password\":{\"type\":\"string\"}}}}}},\"responses\":{\"200\":{\"description\":\"Returns { token }\"},\"401\":{\"description\":\"Invalid credentials\"}}}},\"/workspaces\":{\"get\":{\"tags\":[\"Workspaces\"],\"summary\":\"List my workspaces\",\"security\":[{\"bearerAuth\":[]}],\"responses\":{\"200\":{\"description\":\"Array of workspaces\"},\"401\":{\"description\":\"Unauthorized\"}}},\"post\":{\"tags\":[\"Workspaces\"],\"summary\":\"Create a workspace\",\"security\":[{\"bearerAuth\":[]}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"name\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":150}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"}}}},\"/workspaces/{id}\":{\"get\":{\"tags\":[\"Workspaces\"],\"summary\":\"Get a workspace with members\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Workspace with members\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/workspaces/{id}/members\":{\"post\":{\"tags\":[\"Workspaces\"],\"summary\":\"Add a member to a workspace\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"userId\",\"role\"],\"properties\":{\"userId\":{\"type\":\"integer\"},\"role\":{\"type\":\"string\",\"enum\":[\"owner\",\"member\"]}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/workspaces/{wid}/projects\":{\"get\":{\"tags\":[\"Projects\"],\"summary\":\"List projects in a workspace\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"wid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"limit\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":20}},{\"name\":\"offset\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":0}}],\"responses\":{\"200\":{\"description\":\"Array of projects\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"}}},\"post\":{\"tags\":[\"Projects\"],\"summary\":\"Create a project\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"wid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"name\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":150},\"description\":{\"type\":\"string\"}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"}}}},\"/projects/{id}\":{\"get\":{\"tags\":[\"Projects\"],\"summary\":\"Get a project (board -\\u003e column -\\u003e task nested)\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Project detail\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}},\"patch\":{\"tags\":[\"Projects\"],\"summary\":\"Update a project\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":false,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"}}}}}},\"responses\":{\"200\":{\"description\":\"Updated\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}},\"delete\":{\"tags\":[\"Projects\"],\"summary\":\"Delete a project (deep)\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"204\":{\"description\":\"Deleted\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/projects/{pid}/boards\":{\"post\":{\"tags\":[\"Boards\"],\"summary\":\"Create a board\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"pid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"name\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":150}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/boards/{bid}/columns\":{\"post\":{\"tags\":[\"Columns\"],\"summary\":\"Create a column\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"bid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"name\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":150}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/columns/{id}\":{\"patch\":{\"tags\":[\"Columns\"],\"summary\":\"Update a column (name / position)\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":false,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"position\":{\"type\":\"integer\"}}}}}},\"responses\":{\"200\":{\"description\":\"Updated\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/columns/{cid}/tasks\":{\"post\":{\"tags\":[\"Tasks\"],\"summary\":\"Create a task in a column\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"cid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"title\"],\"properties\":{\"title\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":300},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"dueDate\":{\"type\":\"string\",\"format\":\"date-time\"}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/projects/{pid}/tasks\":{\"get\":{\"tags\":[\"Tasks\"],\"summary\":\"List tasks in a project (filter + pagination)\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"pid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"status\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"name\":\"priority\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"name\":\"page\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":1}},{\"name\":\"pageSize\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":20}}],\"responses\":{\"200\":{\"description\":\"Paginated task list\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}\":{\"get\":{\"tags\":[\"Tasks\"],\"summary\":\"Get a task with assignees, labels, comments\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Task with relations\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}},\"patch\":{\"tags\":[\"Tasks\"],\"summary\":\"Update a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":false,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"dueDate\":{\"type\":\"string\",\"format\":\"date-time\"}}}}}},\"responses\":{\"200\":{\"description\":\"Updated\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}/move\":{\"post\":{\"tags\":[\"Tasks\"],\"summary\":\"Move a task to a column + position\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"columnId\",\"position\"],\"properties\":{\"columnId\":{\"type\":\"integer\"},\"position\":{\"type\":\"integer\"}}}}}},\"responses\":{\"200\":{\"description\":\"Moved\"},\"400\":{\"description\":\"Invalid target column\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}/labels\":{\"post\":{\"tags\":[\"Tasks\"],\"summary\":\"Attach a label to a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"labelId\"],\"properties\":{\"labelId\":{\"type\":\"integer\"}}}}}},\"responses\":{\"200\":{\"description\":\"Task with relations\"},\"400\":{\"description\":\"Label invalid / cross-workspace\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}/labels/{labelId}\":{\"delete\":{\"tags\":[\"Tasks\"],\"summary\":\"Detach a label from a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"labelId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"204\":{\"description\":\"Detached\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}/assignees\":{\"post\":{\"tags\":[\"Tasks\"],\"summary\":\"Assign a user to a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"userId\"],\"properties\":{\"userId\":{\"type\":\"integer\"}}}}}},\"responses\":{\"200\":{\"description\":\"Task with relations\"},\"400\":{\"description\":\"Assignee not a workspace member\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/tasks/{id}/assignees/{userId}\":{\"delete\":{\"tags\":[\"Tasks\"],\"summary\":\"Unassign a user from a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"userId\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"204\":{\"description\":\"Unassigned\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/workspaces/{wid}/labels\":{\"get\":{\"tags\":[\"Labels\"],\"summary\":\"List labels in a workspace\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"wid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Array of labels\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"}}},\"post\":{\"tags\":[\"Labels\"],\"summary\":\"Create a label\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"wid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"name\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":80},\"color\":{\"type\":\"string\",\"default\":\"#888888\"}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"}}}},\"/tasks/{tid}/comments\":{\"get\":{\"tags\":[\"Comments\"],\"summary\":\"List comments on a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"tid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"limit\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":20}},{\"name\":\"offset\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":0}}],\"responses\":{\"200\":{\"description\":\"Array of comments\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}},\"post\":{\"tags\":[\"Comments\"],\"summary\":\"Add a comment to a task\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"tid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4000}}}}}},\"responses\":{\"201\":{\"description\":\"Created\"},\"400\":{\"description\":\"Validation failed\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/projects/{pid}/stats\":{\"get\":{\"tags\":[\"Stats\"],\"summary\":\"Project task stats (by status / column / assignee)\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"pid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Stats payload\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/projects/{pid}/activity\":{\"get\":{\"tags\":[\"Activity\"],\"summary\":\"Recent project activity feed\",\"security\":[{\"bearerAuth\":[]}],\"parameters\":[{\"name\":\"pid\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"Array of activity entries\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Not a member\"},\"404\":{\"description\":\"Not found\"}}}},\"/openapi.json\":{\"get\":{\"tags\":[\"Docs\"],\"summary\":\"This OpenAPI document\",\"responses\":{\"200\":{\"description\":\"OpenAPI 3.0 JSON\"}}}},\"/docs\":{\"get\":{\"tags\":[\"Docs\"],\"summary\":\"Swagger UI\",\"responses\":{\"200\":{\"description\":\"Interactive API docs (HTML)\"}}}}}}";
}
