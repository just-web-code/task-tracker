entity Task of AppDb {
    id          int pk autoincrement;
    columnId    int;
    // Denormalized: tasks are queried per-project, but JWC has no cross-entity
    // join, so we carry projectId directly to avoid column->board->project
    // fan-out on every list query. Stable: move only re-parents within a project.
    projectId   int;
    title       varchar(300);
    description varchar(4000);
    status      varchar(30);
    priority    varchar(20);
    position    int;
    dueDate     datetime nullable;
    createdById int;
    createdAt   datetime;
    updatedAt   datetime;
    labels: List<Label> via TaskLabel(taskId, labelId);
    assignees: List<User> { id, email, name } via TaskAssignee(taskId, userId);
}

class CreateTaskRequest {
    title       string;
    description string;
    status      string;
    priority    string;
    dueDate     string;
}

class MoveTaskRequest {
    columnId int;
    position int;
}
