dome TaskService {
    function create(columnId: int, projectId: int, createdById: int, req) {
        // 0.4.9: scalar count(*) is reliable — no need to fetch the whole column
        // just to size it. New tasks append at the end; `move` handles
        // in-place renumbering atomically.
        let n = select count(*) from AppDb.Task where Task.columnId == @columnId;
        let pos = n + 1;

        let t = new Task();
        t.columnId = columnId;
        t.projectId = projectId;
        t.title = req.title;
        t.description = "";
        if (req.description != null) {
            t.description = req.description;
        }
        t.status = "todo";
        if (req.status != null) {
            t.status = req.status;
        }
        t.priority = "medium";
        if (req.priority != null) {
            t.priority = req.priority;
        }
        t.position = pos;
        if (req.dueDate != null) {
            t.dueDate = req.dueDate;
        }
        t.createdById = createdById;
        t.createdAt = now();
        t.updatedAt = now();
        insert t into AppDb.Task;
        return t;
    }

    function getById(id: int): Task? {
        return select Task from AppDb.Task where Task.id == @id first;
    }

    // Query Layer: load a task with its m2m labels + assignees (assignees
    // projected to id/email/name, no passwordHash) in one query — replaces the
    // per-link N+1 of the old labelsFor/assigneesFor helpers.
    function getWithRelations(id: int): Task? {
        return select Task with labels, assignees from AppDb.Task where Task.id == @id first;
    }

    // 0.4.9: `update <var> in` accepts a select-loaded Record, so PATCH is the
    // canonical load → mutate changed fields → update → return pattern (no
    // re-select, no new-row dirty-tracking trick). Untouched fields keep their
    // loaded values.
    function update(id: int, req) {
        let t = select Task from AppDb.Task where Task.id == @id first;
        if (t == null) {
            return null;
        }
        if (req.title != null) {
            t.title = req.title;
        }
        if (req.description != null) {
            t.description = req.description;
        }
        if (req.status != null) {
            t.status = req.status;
        }
        if (req.priority != null) {
            t.priority = req.priority;
        }
        if (req.dueDate != null) {
            t.dueDate = req.dueDate;
        }
        t.updatedAt = now();
        update t in AppDb.Task;
        return t;
    }

    // Reorder/move, fully atomic — no load-modify-save (closes the lost-update
    // window of the old whole-row `update t in`). Positions are renumbered
    // in-place with `set position = position +/- 1` (D3 column arithmetic), so
    // ordering stays gap-free. Same-column drag shifts only the span between the
    // old and new slot; a cross-column move closes the gap in the source column
    // and opens one in the target.
    function move(id, oldColumnId, oldPosition, newColumnId, newPosition) {
        if (oldColumnId == newColumnId) {
            if (newPosition > oldPosition) {
                update AppDb.Task set position = position - 1
                    where Task.columnId == @newColumnId
                      and Task.position > @oldPosition
                      and Task.position <= @newPosition;
            }
            if (newPosition < oldPosition) {
                update AppDb.Task set position = position + 1
                    where Task.columnId == @newColumnId
                      and Task.position >= @newPosition
                      and Task.position < @oldPosition;
            }
        } else {
            update AppDb.Task set position = position - 1
                where Task.columnId == @oldColumnId and Task.position > @oldPosition;
            update AppDb.Task set position = position + 1
                where Task.columnId == @newColumnId and Task.position >= @newPosition;
        }
        update AppDb.Task set columnId = newColumnId, position = newPosition, updatedAt = now()
            where Task.id == @id;
        return select Task from AppDb.Task where Task.id == @id first;
    }

    // Filter + pagination, fully DB-side. Query Layer `==?` drops the
    // status/priority predicate when the value is "" (no filter), so a single
    // static query covers every filter combination — no in-code branch or fetch
    // (was the last in-code-filter workaround). count(*) + bound limit/offset.
    function listByProject(projectId: int, status: string, priority: string, page: int, pageSize: int) {
        let off = (page - 1) * pageSize;
        let total = select count(*) from AppDb.Task
            where Task.projectId == @projectId and Task.status ==? @status and Task.priority ==? @priority;
        let items = select Task from AppDb.Task
            where Task.projectId == @projectId and Task.status ==? @status and Task.priority ==? @priority
            orderby Task.position asc
            limit @pageSize offset @off;
        return {
            page:     page,
            pageSize: pageSize,
            total:    total,
            items:    items
        };
    }

    // ---- m2m: labels ----

    function addLabel(taskId: int, labelId: int) {
        let existing = select TaskLabel from AppDb.TaskLabel
            where TaskLabel.taskId == @taskId and TaskLabel.labelId == @labelId first;
        if (existing != null) {
            return;
        }
        let tl = new TaskLabel();
        tl.taskId = taskId;
        tl.labelId = labelId;
        insert tl into AppDb.TaskLabel;
    }

    function removeLabel(taskId: int, labelId: int) {
        delete from AppDb.TaskLabel
            where TaskLabel.taskId == @taskId and TaskLabel.labelId == @labelId;
    }

    // ---- m2m: assignees ----

    function addAssignee(taskId: int, userId: int) {
        let existing = select TaskAssignee from AppDb.TaskAssignee
            where TaskAssignee.taskId == @taskId and TaskAssignee.userId == @userId first;
        if (existing != null) {
            return;
        }
        let ta = new TaskAssignee();
        ta.taskId = taskId;
        ta.userId = userId;
        insert ta into AppDb.TaskAssignee;
    }

    function removeAssignee(taskId: int, userId: int) {
        delete from AppDb.TaskAssignee
            where TaskAssignee.taskId == @taskId and TaskAssignee.userId == @userId;
    }
}
