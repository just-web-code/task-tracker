route GET "/workspaces" use Auth {
    let userId = context("userId");
    let list = WorkspaceService.myWorkspaces(userId);
    return json(list);
}

route POST "/workspaces" use Auth {
    validate body {
        name: required, minLength(1), maxLength(150);
    }
    let userId = context("userId");
    let req = body();
    let ws = WorkspaceService.createWithOwner(userId, req.name);
    return created(json(ws));
}

route GET "/workspaces/{id}" use Auth {
    let userId = context("userId");
    let id = int(path_param("id"));
    let ws = WorkspaceService.getById(id);
    if (ws == null) {
        return notFound();
    }
    if (!WorkspaceService.isMember(id, userId)) {
        return forbidden();
    }
    let members = WorkspaceService.members(id);
    return json({
        id:        ws.id,
        name:      ws.name,
        ownerId:   ws.ownerId,
        createdAt: ws.createdAt,
        members:   members
    });
}

route POST "/workspaces/{id}/members" use Auth {
    validate body {
        userId: required;
        role:   required;
    }
    let actorId = context("userId");
    let id = int(path_param("id"));
    let ws = WorkspaceService.getById(id);
    if (ws == null) {
        return notFound();
    }
    if (!WorkspaceService.isMember(id, actorId)) {
        return forbidden();
    }
    let req = body();
    let member = WorkspaceService.addMember(id, req.userId, req.role);
    return created(json(member));
}
