entity Workspace of AppDb {
    id        int pk autoincrement;
    name      varchar(150);
    ownerId   int;
    createdAt datetime;
}

entity WorkspaceMember of AppDb {
    id          int pk autoincrement;
    workspaceId int;
    userId      int;
    role        varchar(20);
    workspace: Workspace via workspaceId;
}

class CreateWorkspaceRequest {
    name string;
}

class AddMemberRequest {
    userId int;
    role   string;
}
