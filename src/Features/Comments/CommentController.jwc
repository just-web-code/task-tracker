route GET "/tasks/{tid}/comments" use Auth {
    let userId = context("userId");
    let tid = int(path_param("tid"));
    let t = TaskService.getById(tid);
    if (t == null) {
        return notFound();
    }
    let proj = ProjectService.getById(t.projectId);
    if (proj == null) {
        return notFound();
    }
    if (!WorkspaceService.isMember(proj.workspaceId, userId)) {
        return forbidden();
    }
    let limit = 20;
    let limitStr = query_param("limit");
    if (limitStr != "") {
        limit = int(limitStr);
    }
    let offset = 0;
    let offsetStr = query_param("offset");
    if (offsetStr != "") {
        offset = int(offsetStr);
    }
    return json(CommentService.listByTask(tid, limit, offset));
}

route POST "/tasks/{tid}/comments" use Auth {
    validate body {
        body: required, minLength(1), maxLength(4000);
    }
    let userId = context("userId");
    let tid = int(path_param("tid"));
    let t = TaskService.getById(tid);
    if (t == null) {
        return notFound();
    }
    let proj = ProjectService.getById(t.projectId);
    if (proj == null) {
        return notFound();
    }
    if (!WorkspaceService.isMember(proj.workspaceId, userId)) {
        return forbidden();
    }
    let req = body();
    let c = CommentService.create(tid, userId, req.body);
    ActivityService.record(proj.id, userId, "comment.added", { taskId: tid, commentId: c.id });
    return created(json(c));
}
