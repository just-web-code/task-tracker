dome ProjectService {
    function create(workspaceId: int, name: string, description: string) {
        let p = new Project();
        p.workspaceId = workspaceId;
        p.name = name;
        p.description = description;
        p.createdAt = now();
        insert p into AppDb.Project;
        return p;
    }

    function listByWorkspace(workspaceId: int, limit: int, offset: int) {
        // 0.4.9: DB-side paging — count(*) for the total, bound limit/offset for
        // the page. No full-table fetch.
        let total = select count(*) from AppDb.Project where Project.workspaceId == @workspaceId;
        let items = select Project from AppDb.Project
            where Project.workspaceId == @workspaceId
            orderby Project.createdAt asc
            limit @limit offset @offset;
        return { items: items, limit: limit, offset: offset, total: total };
    }

    function getById(id: int): Project? {
        return select Project from AppDb.Project where Project.id == @id first;
    }

    // Project + boards + columns in ONE statement: two-level nested eager-load
    // `with boards.columns` collapses the project root, its boards, and each
    // board's columns into a single query (was: a separate boards-with-columns
    // select). Board + column ordering come from the nav declarations'
    // `orderby position asc`, so the materialised tree is deterministic.
    function detail(p) {
        let pid = p.id;
        return select Project with boards.columns from AppDb.Project
            where Project.id == @pid first;
    }

    // 0.4.9: a typed `class` param no longer forces every field present (partial
    // PATCH), and `update <var> in` accepts the select-loaded row. So PATCH takes
    // the DTO directly: load → set the fields that were sent → update → return.
    function update(id: int, req: UpdateProjectRequest) {
        let p = select Project from AppDb.Project where Project.id == @id first;
        if (p == null) {
            return null;
        }
        if (req.name != null) {
            p.name = req.name;
        }
        if (req.description != null) {
            p.description = req.description;
        }
        update p in AppDb.Project;
        return p;
    }

    // Manual cascade: no FK on-delete-cascade declared, so wipe the subtree
    // in one transaction (pain log #5 — multi-step atomic write). Columns are
    // deleted in a single `in (@boardIds)` (= ANY) statement instead of one
    // delete per board — the write-path N+1 that needed dynamic in-list (2b).
    function deleteDeep(projectId: int) {
        transaction {
            let boards = select Board { id } from AppDb.Board where Board.projectId == @projectId;
            let boardIds = [];
            for b in boards {
                push(boardIds, b.id);
            }
            delete from AppDb.Column where Column.boardId in (@boardIds);
            delete from AppDb.Board where Board.projectId == @projectId;
            delete from AppDb.Project where Project.id == @projectId;
        }
    }
}
