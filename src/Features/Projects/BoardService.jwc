dome BoardService {
    function create(projectId: int, name: string) {
        let n = select count(*) from AppDb.Board where Board.projectId == @projectId;
        let pos = n + 1;
        let b = new Board();
        b.projectId = projectId;
        b.name = name;
        b.position = pos;
        insert b into AppDb.Board;
        return b;
    }

    function getById(id: int): Board? {
        return select Board from AppDb.Board where Board.id == @id first;
    }
}
